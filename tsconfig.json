{
  "compilerOptions": {
    "target": "es2016",
    "lib": ["dom", "es2017"],
    "strict": true,
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["chrome"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  // Cópias de trabalho (backups locais), fora da verificação
  "exclude": ["node_modules", "dist", "src/**/* copy*"]
}
